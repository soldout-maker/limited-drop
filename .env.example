# 이 파일을 .env로 복사해서 사용하세요. 실제 값은 절대 커밋하지 않습니다.
# 아직 DB / Redis / 인증 방식이 결정되지 않아 최소 항목만 둡니다. (docs/decisions.md 참고)

# --- api ---
API_PORT=4000

# --- 추후 확정 (사용 기술 결정 후 주석 해제, 이름도 그때 확정) ---
# 실제 키는 팀 비밀값 공유 방법(D-025)으로 받습니다. 메신저 · 노션에 붙여 넣지 않습니다.
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 노출됩니다.

# DATABASE_URL=                  # D-003, D-008
# REDIS_URL=                     # D-006
# JWT_SECRET=                    # D-009
# TOSS_SECRET_KEY=               # D-010 (서버 전용)
# NEXT_PUBLIC_TOSS_CLIENT_KEY=   # D-010 (브라우저 노출 가능한 키만)
# KAKAO_REST_API_KEY=            # D-009 / D-024 (용도 확인 필요)
# PUBLIC_DATA_API_KEY=           # D-024 (공공데이터)
